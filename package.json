{
  "name": "the-echo-archives",
  "private": true,
  "scripts": {
    "start": "node tools/run-backend.js",
    "build:catalog": "node tools/build-catalog.js",
    "validate:data": "npm --prefix backend run validate:data",
    "dev": "node tools/run-backend.js --watch",
    "check:config": "node tools/run-backend.js --check-config",
    "backup:database": "node tools/backup-database.js",
    "check:backup": "node tools/check-database-backup.js",
    "report:catalog": "node tools/report-catalog.js",
    "report:similarity": "node tools/report-similarity.js",
    "report:recommendation-coverage": "node tools/report-recommendation-coverage.js",
    "report:discovery-quality": "node tools/report-discovery-quality.js",
    "report:metadata-quality": "node tools/report-metadata-quality.js",
    "report:collection-candidates": "node tools/report-collection-candidates.js",
    "report:collection-catalogue": "node tools/report-collection-catalogue.js",
    "benchmark:discovery": "node tools/report-discovery-benchmark.js",
    "benchmark:personal-discovery": "node tools/benchmark-personal-discovery.js",
    "test:personal-discovery": "node --test tools/test/discovery-personalization.test.js",
    "benchmark:catalog-scale": "node --expose-gc tools/benchmark-catalog-scale.js",
    "test:discovery-benchmark": "node --test tools/test/discovery-golden-benchmark.test.js tools/test/discovery-v2.test.js",
    "check:collection-catalogue": "node tools/report-collection-catalogue.js --check",
    "report:entity-graph": "node backend/scripts/entity-graph-report.js",
    "report:entity-candidates": "node backend/scripts/entity-enrichment-candidates.js",
    "report:entity-attribution": "node backend/scripts/entity-attribution.js",
    "report:provenance": "node tools/report-provenance.js",
    "report:catalogue-expansion": "node tools/report-catalogue-expansion-progress.js",
    "catalog:enrich:discovery": "node tools/enrich-discovery.js",
    "catalog:new:show": "node tools/scaffold-catalog.js show",
    "catalog:new:collection": "node tools/scaffold-catalog.js collection",
    "build:pages": "node tools/build-pages.js",
    "check:generated": "node tools/check-generated-boundary.js",
    "check:structure": "node tools/check-structure.js",
    "check:release-artifact": "node deploy/catalog-sanity.js .",
    "check:build-determinism": "node tools/check-build-determinism.js",
    "test:tools": "node --test tools/test/*.test.js",
    "verify": "npm run build:catalog && npm run build:pages && npm run check:structure && npm run check:generated && npm run check:release-artifact && npm run test:tools && npm run check:build-determinism && npm --prefix backend run verify"
  },
  "engines": {
    "node": ">=22.12"
  }
}
