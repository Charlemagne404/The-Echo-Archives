# Copy to /etc/echo-archives/offsite-backup.env as root and set mode 0600.
# Do not put real credentials in this repository.
RESTIC_REPOSITORY=s3:https://provider.example/echo-archives
RESTIC_PASSWORD_FILE=/etc/echo-archives/restic-password

# Add only the least-privilege variables required by the selected backend.
# AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY
