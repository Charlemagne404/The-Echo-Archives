echoarchives.net {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@not_cloudflare {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	route {
		# Keep the peer gate and terminal handler in one literal-order route.
		# A separate top-level route is sorted ahead of abort by the adapter.
		abort @not_cloudflare
		reverse_proxy 127.0.0.1:3010 {
			# The peer gate above makes CF-Connecting-IP authoritative here.
			# Overwrite rather than append so clients cannot supply a spoofed
			# X-Forwarded-For value to Express.
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
}

www.echoarchives.net {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	@not_cloudflare {
		not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	route {
		abort @not_cloudflare
		redir https://echoarchives.net{uri} permanent
	}
}

echo.continental-hub.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	redir https://echoarchives.net{uri} permanent
}
