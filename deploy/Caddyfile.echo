echoarchives.net {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	route {
		reverse_proxy 127.0.0.1:3010
	}
}

www.echoarchives.net {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	redir https://echoarchives.net{uri} permanent
}

echo.continental-hub.com {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	redir https://echoarchives.net{uri} permanent
}
