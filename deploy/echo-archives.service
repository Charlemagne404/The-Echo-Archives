[Unit]
Description=The Echo Archives website and API
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=charlie
Group=charlie
WorkingDirectory=/home/charlie/The-Echo-Archives/backend
Environment=PORT=3010
Environment=STATIC_ROOT=/home/charlie/The-Echo-Archives
Environment=SERVE_STATIC=true
Environment=SITE_URL=https://echo.continental-hub.com
Environment=DB_PATH=/home/charlie/The-Echo-Archives/backend/data/community.sqlite
Environment=OLLAMA_URL=http://127.0.0.1:11434/api/generate
Environment=OLLAMA_MODEL=mistral
Environment=REQUEST_TIMEOUT_MS=30000
EnvironmentFile=-/home/charlie/The-Echo-Archives/backend/.env
ExecStart=/usr/bin/node /home/charlie/The-Echo-Archives/backend/server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
