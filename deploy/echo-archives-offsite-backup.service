[Unit]
Description=Encrypted off-site backup for The Echo Archives
Requires=echo-archives-backup.service
After=network-online.target echo-archives-backup.service
Wants=network-online.target
ConditionPathExists=/etc/echo-archives/offsite-backup.env

[Service]
Type=oneshot
Environment=HOME=/root
Environment=RESTIC_CACHE_DIR=/var/cache/echo-archives-restic
EnvironmentFile=/etc/echo-archives/offsite-backup.env
ExecStart=/home/charlie/The-Echo-Archives/deploy/echo-archives-offsite-backup.sh
UMask=0077
CacheDirectory=echo-archives-restic
CacheDirectoryMode=0700
StateDirectory=echo-archives-monitoring
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/cache/echo-archives-restic /var/lib/echo-archives-monitoring
