[Unit]
Description=Local production checks for The Echo Archives
After=network-online.target echo-archives.service caddy.service
Wants=network-online.target

[Service]
Type=oneshot
User=echo-archives
Group=echo-archives
WorkingDirectory=/srv/echo-archives/current
EnvironmentFile=-/etc/echo-archives/monitoring.env
Environment=REPO_ROOT=/srv/echo-archives/current
Environment=BACKUP_DIR=/var/backups/echo-archives
ExecStart=/srv/echo-archives/current/deploy/check-echo-archives-production.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/srv/echo-archives
ReadOnlyPaths=/var/lib/echo-archives
