[Unit]
Description=Local production checks for The Echo Archives
After=network-online.target echo-archives.service caddy.service
Wants=network-online.target

[Service]
Type=oneshot
User=echo-archives
Group=echo-archives
WorkingDirectory=/usr/local/lib/echo-archives
EnvironmentFile=-/etc/echo-archives/monitoring.env
Environment=APP_RELEASE_ROOT=/srv/echo-archives/current
Environment=BACKUP_DIR=/var/backups/echo-archives
ExecStart=/bin/bash /usr/local/lib/echo-archives/check-echo-archives-production.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/usr/local/lib/echo-archives
ReadOnlyPaths=/srv/echo-archives
ReadOnlyPaths=/var/lib/echo-archives
