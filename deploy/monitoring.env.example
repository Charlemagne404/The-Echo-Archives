# Copy to /etc/echo-archives/monitoring.env as root and set mode 0600.
# These settings contain no provider credentials.
MAX_BACKUP_AGE_HOURS=30
MIN_FREE_GIB=10
MAX_DISK_PERCENT=80
EXPECTED_COMMUNITY_RATING_WRITES=true
EXPECTED_MAINTAINER_REVIEW=true
EXPECTED_ACCESS_LOGS=true

# Enable only after the encrypted off-site timer and restore drill pass.
REQUIRE_OFFSITE_BACKUP=false
OFFSITE_SUCCESS_MARKER=/var/lib/echo-archives-monitoring/offsite-backup-success
