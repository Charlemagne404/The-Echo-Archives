[Unit]
Description=Verified SQLite backup for The Echo Archives
After=network-online.target echo-archives.service
Wants=network-online.target

[Service]
Type=oneshot
User=echo-archives
Group=echo-archives
WorkingDirectory=/srv/echo-archives/current
Environment=DB_PATH=/var/lib/echo-archives/community.sqlite
Environment=BACKUP_DIR=/var/backups/echo-archives
ExecStart=/usr/bin/node /srv/echo-archives/current/tools/backup-database.js --source /var/lib/echo-archives/community.sqlite
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/srv/echo-archives
ReadOnlyPaths=/var/lib/echo-archives
ReadWritePaths=/var/backups/echo-archives
StandardOutput=journal
StandardError=journal
SyslogIdentifier=echo-archives-backup
