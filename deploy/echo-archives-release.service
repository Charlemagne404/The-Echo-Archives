[Unit]
Description=The Echo Archives production release
After=network-online.target ollama.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=echo-archives
Group=echo-archives
WorkingDirectory=/srv/echo-archives/current/backend
EnvironmentFile=/srv/echo-archives/shared/env/production.env
Environment=NODE_ENV=production
Environment=DEPLOYMENT_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3010
Environment=INTERNAL_HEALTH_PORT=4010
Environment=STATIC_ROOT=/srv/echo-archives/runtime/production/current
Environment=IMPORT_STAGING_ROOT=/srv/echo-archives/runtime/production/current/import-staging
Environment=SERVE_STATIC=true
Environment=SITE_URL=https://echoarchives.net
Environment=DB_PATH=/var/lib/echo-archives/community.sqlite
Environment=OLLAMA_URL=http://127.0.0.1:11434/api/generate
Environment=OLLAMA_MODEL=mistral
Environment=REQUEST_TIMEOUT_MS=30000
ExecStartPre=/usr/bin/node /srv/echo-archives/current/deploy/validate-env.js production
ExecStartPre=/usr/bin/node /srv/echo-archives/current/backend/scripts/check-config.js
ExecStart=/usr/bin/node /srv/echo-archives/current/backend/server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
StateDirectory=echo-archives
StateDirectoryMode=0750
ReadOnlyPaths=/srv/echo-archives/releases
ReadWritePaths=/var/lib/echo-archives
ReadWritePaths=/srv/echo-archives/runtime/production/current/import-staging
ReadWritePaths=/srv/echo-archives/runtime/production/current/catalog-src/shows
ReadWritePaths=/srv/echo-archives/runtime/production/current/images/covers
ReadWritePaths=/srv/echo-archives/runtime/production/current/images/generated/covers
ReadWritePaths=/srv/echo-archives/runtime/production/current/data
ReadWritePaths=/srv/echo-archives/runtime/production/current/data/reviews
ReadWritePaths=/srv/echo-archives/runtime/production/current/docs/generated
SyslogIdentifier=echo-archives
LogNamespace=echo-archives
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
