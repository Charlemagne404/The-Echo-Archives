# Copy to the deployment host's protected shared environment directory and chmod 0600.
# This file is intentionally not a production environment and contains no real secrets.
DEPLOYMENT_ENV=staging
SITE_URL=https://staging.echoarchives.net
DB_PATH=/var/lib/echo-archives-staging/community.sqlite
SQLITE_SYNCHRONOUS=FULL

# Staging exercises the write paths only against its isolated database.
COMMUNITY_RATING_WRITES_ENABLED=true
COMMUNITY_TURNSTILE_ENABLED=false
COMMUNITY_TURNSTILE_SITE_KEY=
COMMUNITY_TURNSTILE_SECRET_KEY=
COMMUNITY_VOTER_HASH_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_STAGING_SECRET

# No analytics, discovery worker, external import credentials, or maintainer mutations in staging.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
IMPORT_AUTO_WORKER=false
IMPORT_AUTO_DISCOVERY=false
MAINTAINER_REVIEW_PASSPHRASE=
MAINTAINER_REVIEW_COOKIE_SECRET=
ACCESS_LOG_ENABLED=false
ACCESS_LOG_HMAC_SECRET=
