# Copy to the deployment host's protected shared environment directory and chmod 0600.
# Replace every placeholder before use. Never commit the real file.
DEPLOYMENT_ENV=production
SITE_URL=https://echoarchives.net
DB_PATH=/var/lib/echo-archives/community.sqlite
SQLITE_SYNCHRONOUS=FULL

COMMUNITY_RATING_WRITES_ENABLED=true
COMMUNITY_TURNSTILE_ENABLED=true
COMMUNITY_TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_TURNSTILE_SITE_KEY
COMMUNITY_TURNSTILE_SECRET_KEY=REPLACE_WITH_PRODUCTION_TURNSTILE_SECRET_KEY
COMMUNITY_VOTER_HASH_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_PRODUCTION_SECRET

ACCESS_LOG_ENABLED=true
ACCESS_LOG_HMAC_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_LOG_SECRET
MAINTAINER_REVIEW_PASSPHRASE=REPLACE_WITH_A_LONG_UNIQUE_MAINTAINER_PASSPHRASE
MAINTAINER_REVIEW_COOKIE_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET

ARCHIVIST_ENABLED=false
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=
PODCAST_INDEX_USER_AGENT=TheEchoArchivesImport/1.0 (+https://echoarchives.net)
IMPORT_AUTO_WORKER=true
IMPORT_AUTO_DISCOVERY=false
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_SRC=
