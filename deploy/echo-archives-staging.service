[Unit]
Description=The Echo Archives staging release
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=echo-archives
Group=echo-archives
WorkingDirectory=/srv/echo-archives/staging/backend
EnvironmentFile=/srv/echo-archives/shared/env/staging.env
Environment=NODE_ENV=production
Environment=DEPLOYMENT_ENV=staging
Environment=HOST=127.0.0.1
Environment=PORT=3011
Environment=INTERNAL_HEALTH_PORT=4011
Environment=STATIC_ROOT=/srv/echo-archives/runtime/staging/current
Environment=IMPORT_STAGING_ROOT=/srv/echo-archives/runtime/staging/current/import-staging
Environment=SERVE_STATIC=true
Environment=SITE_URL=http://127.0.0.1:3011
Environment=DB_PATH=/var/lib/echo-archives-staging/community.sqlite
Environment=ARCHIVIST_ENABLED=false
Environment=IMPORT_AUTO_WORKER=false
Environment=IMPORT_AUTO_DISCOVERY=false
Environment=PLAUSIBLE_DOMAIN=
ExecStartPre=/usr/bin/node /srv/echo-archives/staging/deploy/validate-env.js staging
ExecStartPre=/usr/bin/node /srv/echo-archives/staging/backend/scripts/check-config.js
ExecStart=/usr/bin/node /srv/echo-archives/staging/backend/server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=45
TimeoutStopSec=15
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
StateDirectory=echo-archives-staging
StateDirectoryMode=0750
ReadOnlyPaths=/srv/echo-archives/releases
ReadWritePaths=/var/lib/echo-archives-staging
ReadWritePaths=/srv/echo-archives/runtime/staging/current/import-staging
ReadWritePaths=/srv/echo-archives/runtime/staging/current/catalog-src/shows
ReadWritePaths=/srv/echo-archives/runtime/staging/current/images/covers
ReadWritePaths=/srv/echo-archives/runtime/staging/current/images/generated/covers
ReadWritePaths=/srv/echo-archives/runtime/staging/current/data
ReadWritePaths=/srv/echo-archives/runtime/staging/current/data/reviews
ReadWritePaths=/srv/echo-archives/runtime/staging/current/docs/generated
SyslogIdentifier=echo-archives-staging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
